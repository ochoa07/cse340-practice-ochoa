<%- include('partials/header') %>

<main class="<%= bodyClass %>">
  <p class="eyebrow">CSE 340 / Middleware</p>

  <h1><%= title %></h1>

  <p class="page-intro">
    This page shows the values added by our middleware.
  </p>

  <section class="demo-panel" aria-label="Middleware values">
    <div class="demo-greeting">
      <%- greeting %>
    </div>

    <dl class="demo-values">
      <div>
        <dt>Current year</dt>
        <dd><%= currentYear %></dd>
      </div>

      <div>
        <dt>Current time</dt>
        <dd><%= timestamp %></dd>
      </div>

      <div>
        <dt>Environment</dt>
        <dd><%= NODE_ENV %></dd>
      </div>
    </dl>
  </section>

  <div class="navigation">
    <a href="/">← Back to Home</a>
  </div>
</main>

<%- include('partials/footer') %>