<%- include('../partials/header') %>

<main>
  <div class="faculty-header faculty-profile-header">
  <img
    class="faculty-photo"
    src="/images/faculty/<%= facultyMember.slug %>.<%= facultyMember.slug === 'robert-colvin' ? 'svg' : 'jpg' %>"
    alt="<%= facultyMember.slug === 'robert-colvin' ? 'No portrait available for ' : 'Portrait of ' %><%= facultyMember.name %>"
  >

  <div class="faculty-profile-info">
    <h1><%= facultyMember.name %></h1>
    <p class="course-meta">
      <%= facultyMember.department %> • <%= facultyMember.title %>
    </p>
  </div>
  </div>

  <section class="sections">
    <div class="sections-header">
      <h2>Contact Information</h2>
    </div>

    <div class="section-card">
      <p>
        <strong>Office:</strong>
        <%= facultyMember.office %>
      </p>

      <p>
        <strong>Phone:</strong>
        <a href="tel:<%= facultyMember.phone.replace(/[^\d+]/g, '') %>">
          <%= facultyMember.phone %>
        </a>
      </p>

      <p>
        <strong>Email:</strong>
        <a href="mailto:<%= facultyMember.email %>">
          <%= facultyMember.email %>
        </a>
      </p>
    </div>
  </section>

  <div class="navigation">
    <p>
      <a href="/faculty">&larr; Back to Faculty Directory</a>
    </p>
  </div>
</main>

<%- include('../partials/footer') %>