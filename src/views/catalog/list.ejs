<%- include('../partials/header') %>

<main>
  <h1>Course Catalog</h1>

  <p class="page-intro">
    Explore our courses and view available class sections.
  </p>

  <p class="course-count">
    <%= courses.length %> courses
  </p>

  <div class="course-list">
    <% courses.forEach(course => { %>
      <article class="course-card">
        <span class="course-code"><%= course.courseCode %></span>

        <p class="course-department">
          <%= course.department %>
        </p>

        <h2>
          <a href="/catalog/<%= course.slug %>">
            <%= course.name %>
          </a>
        </h2>

        <p class="course-description">
          <%= course.description %>
        </p>

        <div class="course-card-footer">
          <span><%= course.creditHours %> credits</span>

          <a
            class="text-link"
            href="/catalog/<%= course.slug %>"
          >
            View sections <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    <% }); %>
  </div>
</main>

<%- include('../partials/footer') %>